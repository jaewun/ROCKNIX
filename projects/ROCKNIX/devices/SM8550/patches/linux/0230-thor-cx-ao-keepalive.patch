From: Luke Johnson <jaewun@me.com>
Subject: [PATCH] thor: cx_ao keepalive driver (CX WAKE-restore)
---
diff --git a/drivers/soc/qcom/thor-cx-ao-keepalive.c b/drivers/soc/qcom/thor-cx-ao-keepalive.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/qcom/thor-cx-ao-keepalive.c
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AYN Thor: hold an rpmhpd domain (RPMHPD_CX_AO active-only) at a corner so the
+ * shared cx.lvl resource gets a WAKE-TCS restore vote while SLEEP stays 0 -- CX
+ * collapses during suspend (cxsd) but is restored on wake.
+ */
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+static int cx_ao_keepalive_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0) {
+		pm_runtime_disable(dev);
+		return ret;
+	}
+	return 0;
+}
+
+static const struct of_device_id cx_ao_keepalive_of[] = {
+	{ .compatible = "thor,cx-ao-keepalive" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, cx_ao_keepalive_of);
+
+static struct platform_driver cx_ao_keepalive_drv = {
+	.probe = cx_ao_keepalive_probe,
+	.driver = {
+		.name = "thor-cx-ao-keepalive",
+		.of_match_table = cx_ao_keepalive_of,
+	},
+};
+builtin_platform_driver(cx_ao_keepalive_drv);
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -22,6 +22,7 @@
 obj-$(CONFIG_QCOM_RPMH)		+= qcom_rpmh.o
 qcom_rpmh-y			+= rpmh-rsc.o
 qcom_rpmh-y			+= rpmh.o
+obj-$(CONFIG_QCOM_RPMH)		+= thor-cx-ao-keepalive.o
 obj-$(CONFIG_QCOM_SMD_RPM)	+= rpm-proc.o smd-rpm.o
 obj-$(CONFIG_QCOM_SMEM) +=	smem.o
 obj-$(CONFIG_QCOM_SMEM_STATE) += smem_state.o
