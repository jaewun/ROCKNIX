From: thorch <thorch@localhost>
Subject: [PATCH] thor: add suspend/resume breadcrumb instrumentation (pmtrace)

AYN Thor bring-up diagnostic. Writes compact PM-phase and per-device
breadcrumbs into an unused PMK8550 SDAM range (window 0x50..0x7f) so that
a hard-hang during deep-suspend resume — which wipes RAM on power-cycle —
can be attributed after reboot.

  * kernel/power/thor_pm_breadcrumb.{c,h}: SDAM ring (5 slots @0x50..0x77)
    plus a single last-writer-wins device latch @0x78..0x7f. Writers bail
    in IRQ/irqs-disabled context; otherwise mutex + nvmem_device_write.
  * kernel/power/suspend.c: mark each PM phase boundary (s2idle + deep).
  * drivers/base/power/main.c: latch the FNV-1a hash of dev_name() at the
    entry of device_resume_noirq (0x44) and device_resume (0x45), so after
    a wedge the latch names the exact device whose callback was running.
  * Kconfig/Makefile: CONFIG_THOR_PM_BREADCRUMB (bool, SUSPEND&&NVMEM&&OF).

Pure instrumentation: no existing functional logic is modified.
---
diff --git a/drivers/base/power/main.c b/drivers/base/power/main.c
index 189de52..531dfdc 100644
--- a/drivers/base/power/main.c
+++ b/drivers/base/power/main.c
@@ -724,6 +724,18 @@ static void async_resume_noirq(void *data, async_cookie_t cookie);
  * The driver of @dev will not receive interrupts while this function is being
  * executed.
  */
+#include <linux/thor_pm_breadcrumb.h>
+/* AYN Thor: per-device noirq-resume breadcrumb — FNV-1a of dev_name to SDAM. */
+static u32 thor_pm_dev_hash(const char *s)
+{
+	u32 h = 2166136261u;
+	while (s && *s) {
+		h ^= (u8)*s++;
+		h *= 16777619u;
+	}
+	return h;
+}
+
 static void device_resume_noirq(struct device *dev, pm_message_t state, bool async)
 {
 	pm_callback_t callback = NULL;
@@ -796,6 +808,7 @@ static void device_resume_noirq(struct device *dev, pm_message_t state, bool asy
 	}
 
 Run:
+	thor_pm_breadcrumb_latch_device(0x44, thor_pm_dev_hash(dev_name(dev)));
 	error = dpm_run_callback(callback, dev, state, info);
 
 Skip:
@@ -1117,6 +1130,7 @@ static void device_resume(struct device *dev, pm_message_t state, bool async)
 	}
 
  End:
+	thor_pm_breadcrumb_latch_device(0x45, thor_pm_dev_hash(dev_name(dev)));
 	error = dpm_run_callback(callback, dev, state, info);
 
 	device_unlock(dev);
diff --git a/include/linux/thor_pm_breadcrumb.h b/include/linux/thor_pm_breadcrumb.h
new file mode 100644
index 0000000..57fd517
--- /dev/null
+++ b/include/linux/thor_pm_breadcrumb.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_THOR_PM_BREADCRUMB_H
+#define _LINUX_THOR_PM_BREADCRUMB_H
+
+#include <linux/types.h>
+
+enum thor_pm_breadcrumb_phase {
+	THOR_PM_BC_BOOT			= 0x01,
+	THOR_PM_BC_SUSPEND_START	= 0x10,
+	THOR_PM_BC_DPM_START_DONE	= 0x11,
+	THOR_PM_BC_SUSPEND_ENTER	= 0x20,
+	THOR_PM_BC_PLATFORM_PREP		= 0x21,
+	THOR_PM_BC_DPM_LATE		= 0x22,
+	THOR_PM_BC_PLATFORM_LATE		= 0x23,
+	THOR_PM_BC_DPM_NOIRQ		= 0x24,
+	THOR_PM_BC_PLATFORM_NOIRQ	= 0x25,
+	THOR_PM_BC_S2IDLE_BEGIN		= 0x30,
+	THOR_PM_BC_S2IDLE_LOOP		= 0x31,
+	THOR_PM_BC_S2IDLE_ENTER		= 0x32,
+	THOR_PM_BC_S2IDLE_WAIT		= 0x33,
+	THOR_PM_BC_S2IDLE_EXIT		= 0x34,
+	THOR_PM_BC_DEEP_ENTER		= 0x35,
+	THOR_PM_BC_DEEP_EXIT		= 0x36,
+	THOR_PM_BC_RESUME_NOIRQ		= 0x40,
+	THOR_PM_BC_RESUME_EARLY		= 0x41,
+	THOR_PM_BC_RESUME_DEVICES	= 0x42,
+	THOR_PM_BC_SUSPEND_DONE		= 0x43,
+	THOR_PM_BC_IRQ_WAKE		= 0x50,
+	THOR_PM_BC_UFS_SYSTEM_SUSPEND	= 0x60,
+	THOR_PM_BC_UFS_SYSTEM_SUSPEND_DONE = 0x61,
+	THOR_PM_BC_UFS_SYSTEM_RESUME	= 0x62,
+	THOR_PM_BC_UFS_SYSTEM_RESUME_DONE = 0x63,
+	THOR_PM_BC_UFS_WL_SUSPEND	= 0x64,
+	THOR_PM_BC_UFS_WL_SUSPEND_DONE	= 0x65,
+	THOR_PM_BC_UFS_WL_RESUME	= 0x66,
+	THOR_PM_BC_UFS_WL_RESUME_DONE	= 0x67,
+	THOR_PM_BC_UFS_QCOM_POWER_UP	= 0x68,
+	THOR_PM_BC_UFS_QCOM_POWER_UP_DONE = 0x69,
+	THOR_PM_BC_UFS_QCOM_SUSPEND	= 0x6a,
+	THOR_PM_BC_UFS_QCOM_SUSPEND_DONE = 0x6b,
+	THOR_PM_BC_UFS_QCOM_RESUME	= 0x6c,
+	THOR_PM_BC_UFS_QCOM_RESUME_DONE	= 0x6d,
+	THOR_PM_BC_UFS_QMP_POWER_ON	= 0x70,
+	THOR_PM_BC_UFS_QMP_POWER_ON_DONE = 0x71,
+	THOR_PM_BC_UFS_QMP_CALIBRATE	= 0x72,
+	THOR_PM_BC_UFS_QMP_CALIBRATE_DONE = 0x73,
+	THOR_PM_BC_UFS_QCOM_H8_ENTER_CLKS_DONE = 0x74,
+	THOR_PM_BC_UFS_QCOM_H8_EXIT_CLKS_DONE = 0x75,
+	THOR_PM_BC_UFS_QCOM_PC_VREG_RESUME_DONE = 0x76,
+	THOR_PM_BC_UFS_QCOM_PC_VREG_SUSPEND_DONE = 0x77,
+	THOR_PM_BC_UFS_DME_LINK_STARTUP_DONE = 0x78,
+	THOR_PM_BC_UFS_LINK_STARTUP_PRE = 0x79,
+	THOR_PM_BC_UFS_DME_LINK_STARTUP = 0x7a,
+	THOR_PM_BC_UFS_HBA_ENABLE_RETRY = 0x7b,
+	THOR_PM_BC_UFS_CORE_SUSPEND	= 0x7c,
+	THOR_PM_BC_UFS_CORE_RESUME	= 0x7d,
+	THOR_PM_BC_UFS_CORE_RESUME_VREG	= 0x7e,
+	THOR_PM_BC_UFS_CORE_RESUME_CLKS	= 0x7f,
+	THOR_PM_BC_UFS_QCOM_DEVICE_RESET = 0x80,
+	THOR_PM_BC_UFS_QCOM_REFCLK	= 0x81,
+	THOR_PM_BC_UFS_QCOM_HOST_RESET_DONE = 0x82,
+	THOR_PM_BC_UFS_QCOM_PHY_SET_MODE_DONE = 0x83,
+	THOR_PM_BC_UFS_QCOM_HW_CG_DONE = 0x84,
+	THOR_PM_BC_UFS_LINK_STARTUP_PRE_DONE = 0x85,
+	THOR_PM_BC_UFS_HCE_POST_DONE = 0x86,
+	THOR_PM_BC_UFS_SAVE_CONFIG_DONE = 0x87,
+	THOR_PM_BC_UFS_AH8_CFG_DONE = 0x88,
+	THOR_PM_BC_UFS_RX_LINECFG_DONE = 0x89,
+	THOR_PM_BC_ICE_RESUME_START = 0x90,
+	THOR_PM_BC_ICE_CORE_CLK_DONE = 0x91,
+	THOR_PM_BC_ICE_IFACE_CLK_DONE = 0x92,
+	THOR_PM_BC_ICE_RESUME_DONE = 0x93,
+	THOR_PM_BC_UFS_QCOM_HOST_CLK_STATE = 0x94,
+	THOR_PM_BC_UFS_QMP_PHY_CLK_STATE = 0x95,
+	THOR_PM_BC_RPMH_PD_CB = 0x96,
+	THOR_PM_BC_RPMH_PD_CB_DONE = 0x97,
+};
+
+#ifdef CONFIG_THOR_PM_BREADCRUMB
+void thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data);
+void thor_pm_breadcrumb_mark_error(u8 phase, u8 arg, int error);
+void thor_pm_breadcrumb_latch_wake_irq(unsigned int irq);
+void thor_pm_breadcrumb_latch_device(u8 phase, u32 hash);
+#else
+static inline void thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data) {}
+static inline void thor_pm_breadcrumb_mark_error(u8 phase, u8 arg, int error) {}
+static inline void thor_pm_breadcrumb_latch_wake_irq(unsigned int irq) {}
+static inline void thor_pm_breadcrumb_latch_device(u8 phase, u32 hash) {}
+#endif
+
+static inline u32 thor_pm_breadcrumb_pack_error(int error)
+{
+	return (u32)(s32)error;
+}
+
+static inline u32 thor_pm_breadcrumb_pack_state_irq(unsigned int state,
+						   unsigned int irq)
+{
+	return ((state & 0xffff) << 16) | (irq & 0xffff);
+}
+
+#endif
diff --git a/kernel/power/Kconfig b/kernel/power/Kconfig
index 05337f4..eac61ce 100644
--- a/kernel/power/Kconfig
+++ b/kernel/power/Kconfig
@@ -234,6 +234,14 @@ config PM_DEBUG
 	code. This is helpful when debugging and reporting PM bugs, like
 	suspend support.
 
+config THOR_PM_BREADCRUMB
+	bool "AYN Thor suspend breadcrumb instrumentation"
+	depends on SUSPEND && NVMEM && OF
+	help
+	  Write compact AYN Thor suspend/resume breadcrumbs into an unused
+	  PMK8550 SDAM range so reset/no-return failures can be attributed after
+	  reboot. This is a board bring-up diagnostic facility.
+
 config PM_ADVANCED_DEBUG
 	bool "Extra PM attributes in sysfs for low-level debugging/testing"
 	depends on PM_DEBUG
diff --git a/kernel/power/Makefile b/kernel/power/Makefile
index 773e278..4fa7c37 100644
--- a/kernel/power/Makefile
+++ b/kernel/power/Makefile
@@ -12,6 +12,7 @@ obj-y				+= qos.o
 obj-$(CONFIG_PM)		+= main.o
 obj-$(CONFIG_VT_CONSOLE_SLEEP)	+= console.o
 obj-$(CONFIG_FREEZER)		+= process.o
+obj-$(CONFIG_THOR_PM_BREADCRUMB) += thor_pm_breadcrumb.o
 obj-$(CONFIG_SUSPEND)		+= suspend.o
 obj-$(CONFIG_PM_TEST_SUSPEND)	+= suspend_test.o
 obj-$(CONFIG_HIBERNATION)	+= hibernate.o snapshot.o swap.o
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 57c4426..dfbaad4 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -31,6 +31,7 @@
 #include <linux/compiler.h>
 #include <linux/moduleparam.h>
 #include <linux/fs.h>
+#include <linux/thor_pm_breadcrumb.h>
 
 #include "power.h"
 
@@ -85,6 +86,7 @@ void s2idle_set_ops(const struct platform_s2idle_ops *ops)
 
 static void s2idle_begin(void)
 {
+	thor_pm_breadcrumb_mark(THOR_PM_BC_S2IDLE_BEGIN, 0, 0);
 	s2idle_state = S2IDLE_STATE_NONE;
 }
 
@@ -102,6 +104,9 @@ static void s2idle_enter(void)
 	 * and the subsequent s2idle_state update in which case a wakeup event
 	 * would get lost.
 	 */
+	thor_pm_breadcrumb_mark(THOR_PM_BC_S2IDLE_ENTER, 0,
+				thor_pm_breadcrumb_pack_state_irq(pm_suspend_target_state,
+								  pm_wakeup_irq()));
 	raw_spin_lock_irq(&s2idle_lock);
 	if (pm_wakeup_pending())
 		goto out;
@@ -112,6 +117,9 @@ static void s2idle_enter(void)
 	/* Push all the CPUs into the idle loop. */
 	wake_up_all_idle_cpus();
 	/* Make the current CPU wait so it can enter the idle loop too. */
+	thor_pm_breadcrumb_mark(THOR_PM_BC_S2IDLE_WAIT, 0,
+				thor_pm_breadcrumb_pack_state_irq(pm_suspend_target_state,
+								  pm_wakeup_irq()));
 	swait_event_exclusive(s2idle_wait_head,
 		    s2idle_state == S2IDLE_STATE_WAKE);
 
@@ -127,6 +135,9 @@ static void s2idle_enter(void)
 	s2idle_state = S2IDLE_STATE_NONE;
 	raw_spin_unlock_irq(&s2idle_lock);
 
+	thor_pm_breadcrumb_mark(THOR_PM_BC_S2IDLE_EXIT, 0,
+				thor_pm_breadcrumb_pack_state_irq(pm_suspend_target_state,
+								  pm_wakeup_irq()));
 	trace_suspend_resume(TPS("machine_suspend"), PM_SUSPEND_TO_IDLE, false);
 }
 
@@ -143,6 +154,7 @@ static void s2idle_loop(void)
 	 * Wakeups during the noirq suspend of devices may be spurious, so try
 	 * to avoid them upfront.
 	 */
+	thor_pm_breadcrumb_mark(THOR_PM_BC_S2IDLE_LOOP, 0, 0);
 	for (;;) {
 		if (s2idle_ops && s2idle_ops->wake) {
 			if (s2idle_ops->wake())
@@ -420,27 +432,41 @@ static int suspend_enter(suspend_state_t state, bool *wakeup)
 {
 	int error;
 
+	thor_pm_breadcrumb_mark(THOR_PM_BC_SUSPEND_ENTER, state, 0);
+
 	error = platform_suspend_prepare(state);
 	if (error)
 		goto Platform_finish;
+	thor_pm_breadcrumb_mark(THOR_PM_BC_PLATFORM_PREP, state,
+				thor_pm_breadcrumb_pack_error(error));
 
 	error = dpm_suspend_late(PMSG_SUSPEND);
 	if (error) {
 		pr_err("late suspend of devices failed\n");
 		goto Platform_finish;
 	}
+	thor_pm_breadcrumb_mark(THOR_PM_BC_DPM_LATE, state,
+				thor_pm_breadcrumb_pack_error(error));
+
 	error = platform_suspend_prepare_late(state);
 	if (error)
 		goto Devices_early_resume;
+	thor_pm_breadcrumb_mark(THOR_PM_BC_PLATFORM_LATE, state,
+				thor_pm_breadcrumb_pack_error(error));
 
 	error = dpm_suspend_noirq(PMSG_SUSPEND);
 	if (error) {
 		pr_err("noirq suspend of devices failed\n");
 		goto Platform_early_resume;
 	}
+	thor_pm_breadcrumb_mark(THOR_PM_BC_DPM_NOIRQ, state,
+				thor_pm_breadcrumb_pack_error(error));
+
 	error = platform_suspend_prepare_noirq(state);
 	if (error)
 		goto Platform_wake;
+	thor_pm_breadcrumb_mark(THOR_PM_BC_PLATFORM_NOIRQ, state,
+				thor_pm_breadcrumb_pack_error(error));
 
 	if (suspend_test(TEST_PLATFORM))
 		goto Platform_wake;
@@ -454,6 +480,8 @@ static int suspend_enter(suspend_state_t state, bool *wakeup)
 	if (error || suspend_test(TEST_CPUS))
 		goto Enable_cpus;
 
+	thor_pm_breadcrumb_mark(THOR_PM_BC_DEEP_ENTER, state, pm_wakeup_irq());
+
 	arch_suspend_disable_irqs();
 	BUG_ON(!irqs_disabled());
 
@@ -479,11 +507,14 @@ static int suspend_enter(suspend_state_t state, bool *wakeup)
 	arch_suspend_enable_irqs();
 	BUG_ON(irqs_disabled());
 
+	thor_pm_breadcrumb_mark(THOR_PM_BC_DEEP_EXIT, state, pm_wakeup_irq());
+
  Enable_cpus:
 	pm_sleep_enable_secondary_cpus();
 
  Platform_wake:
 	platform_resume_noirq(state);
+	thor_pm_breadcrumb_mark(THOR_PM_BC_RESUME_NOIRQ, state, pm_wakeup_irq());
 	dpm_resume_noirq(PMSG_RESUME);
 
  Platform_early_resume:
@@ -491,6 +522,7 @@ static int suspend_enter(suspend_state_t state, bool *wakeup)
 
  Devices_early_resume:
 	dpm_resume_early(PMSG_RESUME);
+	thor_pm_breadcrumb_mark(THOR_PM_BC_RESUME_EARLY, state, pm_wakeup_irq());
 
  Platform_finish:
 	platform_resume_finish(state);
@@ -511,6 +543,8 @@ int suspend_devices_and_enter(suspend_state_t state)
 
 	pm_suspend_target_state = state;
 
+	thor_pm_breadcrumb_mark(THOR_PM_BC_SUSPEND_START, state, 0);
+
 	if (state == PM_SUSPEND_TO_IDLE)
 		pm_set_suspend_no_platform();
 
@@ -525,6 +559,8 @@ int suspend_devices_and_enter(suspend_state_t state)
 		pr_err("Some devices failed to suspend, or early wake event detected\n");
 		goto Recover_platform;
 	}
+	thor_pm_breadcrumb_mark(THOR_PM_BC_DPM_START_DONE, state,
+				thor_pm_breadcrumb_pack_error(error));
 	suspend_test_finish("suspend devices");
 	if (suspend_test(TEST_DEVICES))
 		goto Recover_platform;
@@ -535,6 +571,7 @@ int suspend_devices_and_enter(suspend_state_t state)
 
  Resume_devices:
 	suspend_test_start();
+	thor_pm_breadcrumb_mark(THOR_PM_BC_RESUME_DEVICES, state, pm_wakeup_irq());
 	dpm_resume_end(PMSG_RESUME);
 	suspend_test_finish("resume devices");
 	trace_suspend_resume(TPS("console_resume_all"), state, true);
@@ -544,6 +581,9 @@ int suspend_devices_and_enter(suspend_state_t state)
  Close:
 	platform_resume_end(state);
 	pm_suspend_target_state = PM_SUSPEND_ON;
+	thor_pm_breadcrumb_mark(THOR_PM_BC_SUSPEND_DONE, state,
+				thor_pm_breadcrumb_pack_state_irq(state,
+								  pm_wakeup_irq()));
 	return error;
 
  Recover_platform:
diff --git a/kernel/power/thor_pm_breadcrumb.c b/kernel/power/thor_pm_breadcrumb.c
new file mode 100644
index 0000000..9b0eef1
--- /dev/null
+++ b/kernel/power/thor_pm_breadcrumb.c
@@ -0,0 +1,384 @@
+// SPDX-License-Identifier: GPL-2.0
+#define pr_fmt(fmt) "thor-pm-breadcrumb: " fmt
+
+#include <linux/atomic.h>
+#include <linux/byteorder/generic.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/thor_pm_breadcrumb.h>
+#include <linux/types.h>
+
+#define THOR_PM_BC_SDAM_REG		0x7100
+#define THOR_PM_BC_OFFSET		0x50
+/*
+ * AYN Thor wedge localization: a single fixed-slot "last resuming device"
+ * latch, written from process context just before each device's resume
+ * callback runs. Unlike the ring (which churns through hundreds of per-device
+ * marks and reads back torn), this one fixed location is fully overwritten
+ * each device, so after a resume wedge + reboot it reliably names the last
+ * device that entered resume. The live qcom-spmi-sdam window only accepts
+ * writes in 0x50..0x7f (offset 0x40 returns -EINVAL), so the latch lives at
+ * 0x78..0x7f and the ring is shrunk to 5 slots (0x50..0x77) to make room.
+ */
+#define THOR_PM_BC_DEV_LATCH_OFFSET	0x78
+#define THOR_PM_BC_SLOTS		5
+#define THOR_PM_BC_MAX_BANKS		1
+#define THOR_PM_BC_MAX_BANK_SLOTS	THOR_PM_BC_SLOTS
+#define THOR_PM_BC_MAX_RING_SLOTS	THOR_PM_BC_SLOTS
+
+struct thor_pm_breadcrumb_slot {
+	__le16 seq;
+	u8 phase;
+	u8 arg;
+	__le32 data;
+} __packed;
+
+struct thor_pm_breadcrumb_bank {
+	struct nvmem_device *nvmem;
+	u32 reg;
+	u32 offset;
+	unsigned int first_slot;
+	unsigned int slots;
+};
+
+static DEFINE_MUTEX(thor_pm_breadcrumb_lock);
+static struct thor_pm_breadcrumb_bank thor_pm_breadcrumb_banks[THOR_PM_BC_MAX_BANKS];
+static bool thor_pm_breadcrumb_checked;
+static u16 thor_pm_breadcrumb_seq;
+static atomic_t thor_pm_breadcrumb_wake_irq = ATOMIC_INIT(0);
+static atomic_t thor_pm_breadcrumb_sticky_error = ATOMIC_INIT(0);
+static bool thor_pm_breadcrumb_write_warned;
+static u32 thor_pm_breadcrumb_phase_history;
+static unsigned int thor_pm_breadcrumb_bank_count;
+static unsigned int thor_pm_breadcrumb_ring_slots;
+static struct thor_pm_breadcrumb_slot thor_pm_breadcrumb_store[THOR_PM_BC_MAX_RING_SLOTS];
+
+static bool thor_pm_breadcrumb_machine_enabled(void)
+{
+	return of_machine_is_compatible("ayn,thor");
+}
+
+static int thor_pm_breadcrumb_sdam_match(struct device *dev, const void *data)
+{
+	const u32 *target_reg = data;
+	u32 reg;
+
+	if (!dev->of_node)
+		return 0;
+	if (!of_device_is_compatible(dev->of_node, "qcom,spmi-sdam"))
+		return 0;
+	if (of_property_read_u32(dev->of_node, "reg", &reg))
+		return 0;
+
+	return reg == *target_reg;
+}
+
+static const struct thor_pm_breadcrumb_bank *
+thor_pm_breadcrumb_bank_for_slot(unsigned int slot)
+{
+	unsigned int i;
+
+	for (i = 0; i < thor_pm_breadcrumb_bank_count; i++) {
+		const struct thor_pm_breadcrumb_bank *bank =
+			&thor_pm_breadcrumb_banks[i];
+
+		if (slot >= bank->first_slot && slot < bank->first_slot + bank->slots)
+			return bank;
+	}
+
+	return NULL;
+}
+
+static void thor_pm_breadcrumb_log_previous(void)
+{
+	unsigned int i;
+	bool found = false;
+
+	for (i = 0; i < thor_pm_breadcrumb_ring_slots; i++) {
+		const struct thor_pm_breadcrumb_bank *bank;
+		struct thor_pm_breadcrumb_slot *slot = &thor_pm_breadcrumb_store[i];
+		u16 seq = le16_to_cpu(slot->seq);
+
+		if (!seq && !slot->phase && !slot->arg && !slot->data)
+			continue;
+
+		found = true;
+		if (seq > thor_pm_breadcrumb_seq)
+			thor_pm_breadcrumb_seq = seq;
+		bank = thor_pm_breadcrumb_bank_for_slot(i);
+		pr_info("previous ring[%u] bank=0x%04x seq=%u phase=0x%02x arg=0x%02x data=0x%08x\n",
+			i, bank ? bank->reg : 0, seq, slot->phase, slot->arg,
+			le32_to_cpu(slot->data));
+	}
+
+	if (found)
+		pr_info("previous ring max_seq=%u\n", thor_pm_breadcrumb_seq);
+	else
+		pr_info("PMK8550 SDAM breadcrumb banks ready, no previous breadcrumbs\n");
+
+	/* Print the fixed-slot "last resuming device" latch (offset 0x40). */
+	if (thor_pm_breadcrumb_bank_count) {
+		struct thor_pm_breadcrumb_slot dl = { };
+
+		if (nvmem_device_read(thor_pm_breadcrumb_banks[0].nvmem,
+				      THOR_PM_BC_DEV_LATCH_OFFSET,
+				      sizeof(dl), &dl) == sizeof(dl) &&
+		    (dl.seq || dl.phase || dl.data))
+			pr_info("previous device-latch seq=%u phase=0x%02x hash=0x%08x\n",
+				le16_to_cpu(dl.seq), dl.phase,
+				le32_to_cpu(dl.data));
+	}
+}
+
+static void thor_pm_breadcrumb_clear_locked(void)
+{
+	struct thor_pm_breadcrumb_slot zero[THOR_PM_BC_MAX_BANK_SLOTS] = { };
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < thor_pm_breadcrumb_bank_count; i++) {
+		struct thor_pm_breadcrumb_bank *bank = &thor_pm_breadcrumb_banks[i];
+		size_t bytes = bank->slots * sizeof(*zero);
+
+		ret = nvmem_device_write(bank->nvmem, bank->offset, bytes, zero);
+		if (ret != bytes)
+			pr_info("PMK8550 SDAM 0x%04x clear failed: %d\n",
+				bank->reg, ret);
+	}
+
+	/* Clear the fixed-slot device latch (offset 0x40) too. */
+	if (thor_pm_breadcrumb_bank_count) {
+		struct thor_pm_breadcrumb_slot zero_latch = { };
+
+		nvmem_device_write(thor_pm_breadcrumb_banks[0].nvmem,
+				   THOR_PM_BC_DEV_LATCH_OFFSET,
+				   sizeof(zero_latch), &zero_latch);
+	}
+
+	memset(thor_pm_breadcrumb_store, 0, sizeof(thor_pm_breadcrumb_store));
+	thor_pm_breadcrumb_seq = 0;
+}
+
+static int thor_pm_breadcrumb_add_bank(u32 reg, u32 offset, unsigned int slots)
+{
+	struct thor_pm_breadcrumb_bank *bank;
+	struct nvmem_device *nvmem;
+	struct thor_pm_breadcrumb_slot readback[THOR_PM_BC_MAX_BANK_SLOTS] = { };
+	size_t bytes;
+	int ret;
+
+	if (thor_pm_breadcrumb_bank_count >= THOR_PM_BC_MAX_BANKS)
+		return -ENOSPC;
+	if (slots > THOR_PM_BC_MAX_BANK_SLOTS)
+		return -EINVAL;
+
+	nvmem = nvmem_device_find((void *)&reg, thor_pm_breadcrumb_sdam_match);
+	if (IS_ERR(nvmem))
+		return PTR_ERR(nvmem);
+
+	bytes = slots * sizeof(*thor_pm_breadcrumb_store);
+	ret = nvmem_device_read(nvmem, offset, bytes, readback);
+	if (ret != bytes) {
+		nvmem_device_put(nvmem);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	/*
+	 * Some unused PMK8550 SDAM blocks enumerate but reject writes via SPMI.
+	 * Rewriting the first slot with identical bytes proves the bank is usable
+	 * without changing retained content.
+	 */
+	ret = nvmem_device_write(nvmem, offset, sizeof(readback[0]), readback);
+	if (ret != sizeof(readback[0])) {
+		nvmem_device_put(nvmem);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	bank = &thor_pm_breadcrumb_banks[thor_pm_breadcrumb_bank_count++];
+	bank->nvmem = nvmem;
+	bank->reg = reg;
+	bank->offset = offset;
+	bank->first_slot = thor_pm_breadcrumb_ring_slots;
+	bank->slots = slots;
+	thor_pm_breadcrumb_ring_slots += slots;
+	memcpy(&thor_pm_breadcrumb_store[bank->first_slot], readback, bytes);
+
+	pr_info("using PMK8550 SDAM 0x%04x offset 0x%x for %u breadcrumb slots\n",
+		reg, offset, slots);
+
+	return 0;
+}
+
+static int thor_pm_breadcrumb_get_locked(void)
+{
+	int ret = -ENODEV;
+
+	if (thor_pm_breadcrumb_ring_slots)
+		return 0;
+	if (thor_pm_breadcrumb_checked)
+		return -ENODEV;
+
+	/*
+	 * AYN Thor exposes PMK8550 SDAM 0x7100 and 0x9d00. The 0x9d00 bank is
+	 * consumed by haptics. The 0x7100 bank uses byte 0x48 for reboot
+	 * reason and the live qcom-spmi-sdam window only accepts 0x40..0x7f,
+	 * so keep breadcrumbs inside 0x50..0x7f and do not probe/write other
+	 * SDAMs.
+	 */
+	ret = thor_pm_breadcrumb_add_bank(THOR_PM_BC_SDAM_REG,
+					  THOR_PM_BC_OFFSET,
+					  THOR_PM_BC_SLOTS);
+	if (ret) {
+		if (ret != -EPROBE_DEFER) {
+			thor_pm_breadcrumb_checked = true;
+			pr_info("PMK8550 SDAM breadcrumb area unavailable: %d\n",
+				ret);
+		}
+		return ret;
+	}
+
+	thor_pm_breadcrumb_checked = true;
+	thor_pm_breadcrumb_log_previous();
+	thor_pm_breadcrumb_clear_locked();
+
+	return 0;
+}
+
+static void __thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data,
+				      bool sticky_error)
+{
+	const struct thor_pm_breadcrumb_bank *bank;
+	struct thor_pm_breadcrumb_slot *slot;
+	unsigned int wake_irq;
+	unsigned int slot_index;
+	u16 seq;
+	int ret;
+
+	if (!thor_pm_breadcrumb_machine_enabled())
+		return;
+	if (in_interrupt() || irqs_disabled())
+		return;
+
+	if (phase == THOR_PM_BC_BOOT || phase == THOR_PM_BC_SUSPEND_START) {
+		atomic_set(&thor_pm_breadcrumb_sticky_error, 0);
+		thor_pm_breadcrumb_phase_history = 0;
+	}
+	if (!sticky_error && atomic_read(&thor_pm_breadcrumb_sticky_error))
+		return;
+
+	mutex_lock(&thor_pm_breadcrumb_lock);
+	ret = thor_pm_breadcrumb_get_locked();
+	if (ret)
+		goto out_unlock;
+
+	thor_pm_breadcrumb_phase_history =
+		(thor_pm_breadcrumb_phase_history << 8) | phase;
+
+	wake_irq = atomic_read(&thor_pm_breadcrumb_wake_irq);
+	seq = ++thor_pm_breadcrumb_seq;
+	slot_index = seq % thor_pm_breadcrumb_ring_slots;
+	bank = thor_pm_breadcrumb_bank_for_slot(slot_index);
+	if (!bank)
+		goto out_unlock;
+
+	slot = &thor_pm_breadcrumb_store[slot_index];
+	slot->seq = cpu_to_le16(seq);
+	slot->phase = phase;
+	slot->arg = arg;
+	slot->data = cpu_to_le32(data ? data : wake_irq);
+
+	ret = nvmem_device_write(bank->nvmem,
+				 bank->offset +
+				 (slot_index - bank->first_slot) * sizeof(*slot),
+				 sizeof(*slot), slot);
+	if (ret != sizeof(*slot) && !thor_pm_breadcrumb_write_warned) {
+		thor_pm_breadcrumb_write_warned = true;
+		pr_info("PMK8550 SDAM breadcrumb write failed: %d\n", ret);
+	}
+
+	if (sticky_error)
+		atomic_set(&thor_pm_breadcrumb_sticky_error, 1);
+
+out_unlock:
+	mutex_unlock(&thor_pm_breadcrumb_lock);
+}
+
+void thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data)
+{
+	__thor_pm_breadcrumb_mark(phase, arg, data, false);
+}
+EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_mark);
+
+void thor_pm_breadcrumb_mark_error(u8 phase, u8 arg, int error)
+{
+	__thor_pm_breadcrumb_mark(phase, arg,
+				  error ? thor_pm_breadcrumb_pack_error(error) : 0,
+				  error);
+}
+EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_mark_error);
+
+void thor_pm_breadcrumb_latch_wake_irq(unsigned int irq)
+{
+	if (!thor_pm_breadcrumb_machine_enabled())
+		return;
+
+	atomic_set(&thor_pm_breadcrumb_wake_irq, irq);
+}
+EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_latch_wake_irq);
+
+/*
+ * Overwrite the single fixed-slot device latch (SDAM offset 0x40) with the
+ * FNV-1a hash of the device currently entering resume. Called from process
+ * context (device_resume / device_resume_noirq) before dpm_run_callback, so
+ * the callback that wedges leaves its hash latched for the next boot.
+ */
+void thor_pm_breadcrumb_latch_device(u8 phase, u32 hash)
+{
+	struct thor_pm_breadcrumb_slot slot;
+	int ret;
+
+	if (!thor_pm_breadcrumb_machine_enabled())
+		return;
+	if (in_interrupt() || irqs_disabled())
+		return;
+
+	mutex_lock(&thor_pm_breadcrumb_lock);
+	if (thor_pm_breadcrumb_get_locked())
+		goto out_unlock;
+
+	slot.seq = cpu_to_le16(++thor_pm_breadcrumb_seq);
+	slot.phase = phase;
+	slot.arg = 0;
+	slot.data = cpu_to_le32(hash);
+
+	ret = nvmem_device_write(thor_pm_breadcrumb_banks[0].nvmem,
+				 THOR_PM_BC_DEV_LATCH_OFFSET,
+				 sizeof(slot), &slot);
+	if (ret != sizeof(slot) && !thor_pm_breadcrumb_write_warned) {
+		thor_pm_breadcrumb_write_warned = true;
+		pr_info("PMK8550 SDAM device-latch write failed: %d\n", ret);
+	}
+
+out_unlock:
+	mutex_unlock(&thor_pm_breadcrumb_lock);
+}
+EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_latch_device);
+
+static int __init thor_pm_breadcrumb_init(void)
+{
+	if (!thor_pm_breadcrumb_machine_enabled())
+		return 0;
+
+	thor_pm_breadcrumb_mark(THOR_PM_BC_BOOT, 0, 0);
+
+	return 0;
+}
+late_initcall(thor_pm_breadcrumb_init);
