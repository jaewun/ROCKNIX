diff --git a/drivers/base/power/main.c b/drivers/base/power/main.c
--- a/drivers/base/power/main.c
+++ b/drivers/base/power/main.c
@@ -1976,6 +1976,12 @@
 		callback = pm_op(dev->driver->pm, state);
 	}
 
+	/*
+	 * W3 0x78: latch the suspend-side device name-hash before its .suspend
+	 * callback runs, mirroring the resume-side latch. A device whose
+	 * .suspend deadlocks leaves its hash latched for the next boot (#2).
+	 */
+	thor_pm_breadcrumb_latch_dev_suspend(thor_pm_dev_hash(dev_name(dev)));
 	error = dpm_run_callback(callback, dev, state, info);
 
  End:
@@ -2180,8 +2186,16 @@
 	if (!callback && dev->driver && dev->driver->pm)
 		callback = dev->driver->pm->prepare;
 
-	if (callback)
+	if (callback) {
+		/*
+		 * W3 0x78: latch the device name-hash before its .prepare
+		 * callback runs, so a .prepare that deadlocks (e.g. a pwrkey
+		 * wake re-entering logind mid-dpm_prepare) leaves its hash
+		 * latched for the next boot (#2).
+		 */
+		thor_pm_breadcrumb_latch_dev_suspend(thor_pm_dev_hash(dev_name(dev)));
 		ret = callback(dev);
+	}
 
 unlock:
 	device_unlock(dev);
