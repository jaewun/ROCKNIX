diff --git a/kernel/irq/pm.c b/kernel/irq/pm.c
--- a/kernel/irq/pm.c
+++ b/kernel/irq/pm.c
@@ -10,6 +10,7 @@
 #include <linux/interrupt.h>
 #include <linux/suspend.h>
 #include <linux/syscore_ops.h>
+#include <linux/thor_pm_breadcrumb.h>
 
 #include "internals.h"
 
@@ -20,6 +21,14 @@
 	desc->depth++;
 	irq_disable(desc);
 	pm_system_irq_wakeup(irq_desc_get_irq(desc));
+	/*
+	 * W3 Stage-1: capture the armed wake IRQ that just aborted (or tried to
+	 * abort) the suspend. Hardirq context, desc->lock held, IRQs disabled --
+	 * atomic-only, NO SDAM write (the SPMI bus sleeps). Flushed to the 0x70
+	 * latch from process context later. This is the heart of the W3 chase:
+	 * it names WHICH IRQ's wake fired mid-entry.
+	 */
+	thor_pm_breadcrumb_latch_wake_irq(irq_desc_get_irq(desc));
 }
 
