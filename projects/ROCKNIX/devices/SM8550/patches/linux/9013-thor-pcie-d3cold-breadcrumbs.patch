From: thorch <thorch@localhost>
Subject: [PATCH] thor: pcie d3cold suspend/resume SDAM breadcrumbs (diagnostic, do not ship)

Instrument the backported qcom PCIe d3cold suspend/resume path with SDAM
breadcrumbs (0xA0-0xD3) to localize the resume wedge after a hard reboot.
Pairs with CONFIG_THOR_PM_BREADCRUMB. Pure instrumentation, no logic change.
---
--- a/drivers/pci/controller/dwc/pcie-designware-host.c
+++ b/drivers/pci/controller/dwc/pcie-designware-host.c
@@ -23,6 +23,7 @@
 #include "../pci-host-common.h"
 #include "../../pci.h"
 #include "pcie-designware.h"
+#include <linux/thor_pm_breadcrumb.h>	/* AYN Thor d3cold wedge localization */
 
 static struct pci_ops dw_pcie_ops;
 static struct pci_ops dw_pcie_ecam_ops;
@@ -1224,12 +1225,16 @@
 	int ret = 0;
 	u32 val;
 
+	thor_pm_breadcrumb_mark(0xA0, 0, 0);	/* dwc_suspend_noirq entry */
+
 	if (!dw_pcie_link_up(pci))
 		goto stop_link;
 
 	if (!pci_host_common_d3cold_possible(pci->pp.bridge, &pme_capable))
 		return 0;
 
+	thor_pm_breadcrumb_mark(0xA1, 0, 0);	/* d3cold eligible, pre PME_TurnOff */
+
 	if (pci->pp.ops->pme_turn_off) {
 		pci->pp.ops->pme_turn_off(&pci->pp);
 	} else {
@@ -1238,6 +1243,8 @@
 			return ret;
 	}
 
+	thor_pm_breadcrumb_mark(0xA2, 0, 0);	/* PME_TurnOff sent, pre L2 wait */
+
 	/*
 	 * Some SoCs do not support reading the LTSSM register after
 	 * PME_Turn_Off broadcast. For those SoCs, skip waiting for L2/L3 Ready
@@ -1267,6 +1274,7 @@
 	udelay(1);
 
 stop_link:
+	thor_pm_breadcrumb_mark(0xA4, 0, 0);	/* post L2 wait, pre stop_link+deinit */
 	pci->pp.skip_pwrctrl_off = pme_capable;
 	dw_pcie_stop_link(pci);
 	if (pci->pp.ops->deinit)
@@ -1274,6 +1282,8 @@
 
 	pci->suspended = true;
 
+	thor_pm_breadcrumb_mark(0xA5, 0, 0);	/* dwc_suspend_noirq done */
+
 	return ret;
 }
 EXPORT_SYMBOL_GPL(dw_pcie_suspend_noirq);
@@ -1282,9 +1292,13 @@
 {
 	int ret;
 
+	thor_pm_breadcrumb_mark(0xB0, 0, 0);	/* dwc_resume_noirq entry */
+
 	if (!pci->suspended)
 		return 0;
 
+	thor_pm_breadcrumb_mark(0xB1, 0, 0);	/* pre host_init (ops->init) */
+
 	if (pci->pp.ops->init) {
 		ret = pci->pp.ops->init(&pci->pp);
 		if (ret) {
@@ -1293,21 +1307,29 @@
 		}
 	}
 
+	thor_pm_breadcrumb_mark(0xB2, 0, 0);	/* host_init done, pre setup_rc */
+
 	dw_pcie_setup_rc(&pci->pp);
 
 	ret = dw_pcie_start_link(pci);
 	if (ret)
 		goto err_deinit;
 
+	thor_pm_breadcrumb_mark(0xB3, 0, 0);	/* pre wait_for_link */
+
 	ret = dw_pcie_wait_for_link(pci);
 	if (ret == -ETIMEDOUT)
 		goto err_stop_link;
 
+	thor_pm_breadcrumb_mark(0xB4, 0, 0);	/* link up, pre post_init */
+
 	if (pci->pp.ops->post_init)
 		pci->pp.ops->post_init(&pci->pp);
 
 	pci->suspended = false;
 
+	thor_pm_breadcrumb_mark(0xB5, 0, 0);	/* dwc_resume_noirq done */
+
 	return 0;
 
 err_stop_link:
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -24,6 +24,7 @@
 #include <linux/of_pci.h>
 #include <linux/pci.h>
 #include <linux/pci-ecam.h>
+#include <linux/thor_pm_breadcrumb.h>	/* AYN Thor d3cold wedge localization */
 #include <linux/pci-pwrctrl.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
@@ -1354,6 +1355,8 @@
 	struct qcom_pcie *pcie = to_qcom_pcie(pci);
 	int ret;
 
+	thor_pm_breadcrumb_mark(0xC0, 0, 0);	/* qcom host_init entry */
+
 	qcom_pcie_perst_assert(pcie);
 
 	ret = pcie->cfg->ops->init(pcie);
@@ -1370,12 +1373,16 @@
 			goto err_disable_phy;
 	}
 
+	thor_pm_breadcrumb_mark(0xC1, 0, 0);	/* pre pci_pwrctrl_power_on_devices */
+
 	if (!pp->skip_pwrctrl_off) {
 		ret = pci_pwrctrl_power_on_devices(pci->dev);
 		if (ret)
 			goto err_pwrctrl_destroy;
 	}
 
+	thor_pm_breadcrumb_mark(0xC2, 0, 0);	/* post pci_pwrctrl_power_on_devices */
+
 	if (pcie->cfg->ops->post_init) {
 		ret = pcie->cfg->ops->post_init(pcie);
 		if (ret)
@@ -1394,6 +1401,8 @@
 			goto err_assert_reset;
 	}
 
+	thor_pm_breadcrumb_mark(0xC4, 0, 0);	/* qcom host_init success */
+
 	return 0;
 
 err_assert_reset:
@@ -1417,8 +1426,12 @@
 	struct dw_pcie *pci = to_dw_pcie_from_pp(pp);
 	struct qcom_pcie *pcie = to_qcom_pcie(pci);
 
+	thor_pm_breadcrumb_mark(0xD0, 0, 0);	/* qcom host_deinit entry */
+
 	qcom_pcie_perst_assert(pcie);
 
+	thor_pm_breadcrumb_mark(0xD1, 0, 0);	/* pre pci_pwrctrl_power_off_devices */
+
 	if (!pci->pp.skip_pwrctrl_off) {
 		/*
 		 * No need to destroy pwrctrl devices as this function only gets called
@@ -1427,8 +1440,12 @@
 		pci_pwrctrl_power_off_devices(pci->dev);
 	}
 
+	thor_pm_breadcrumb_mark(0xD2, 0, 0);	/* pre phy_power_off + deinit */
+
 	qcom_pcie_phy_power_off(pcie);
 	pcie->cfg->ops->deinit(pcie);
+
+	thor_pm_breadcrumb_mark(0xD3, 0, 0);	/* qcom host_deinit done */
 }
 
 static void qcom_pcie_host_post_init(struct dw_pcie_rp *pp)
