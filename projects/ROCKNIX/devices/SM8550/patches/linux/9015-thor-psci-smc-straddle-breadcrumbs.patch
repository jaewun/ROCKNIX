From: Luke Johnson <jaewun@me.com>
Subject: [PATCH] thor: psci breadcrumbs straddling SYSTEM_SUSPEND SMC (0xE6/0xE7)

Diagnostic: 0xE6 = last SW before the SYSTEM_SUSPEND SMC; 0xE7 = first SW after
cpu_suspend() returns on wake. Distinguishes firmware-never-returns (last=0xE6)
from kernel-resume-fault (0xE7 present, 0xE2 absent).
---
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -19,6 +19,7 @@
 #include <linux/reboot.h>
 #include <linux/slab.h>
 #include <linux/suspend.h>
+#include <linux/thor_pm_breadcrumb.h>
 
 #include <uapi/linux/psci.h>
 
@@ -532,6 +533,7 @@
 	int err;
 	phys_addr_t pa_cpu_resume = __pa_symbol(cpu_resume);
 
+	thor_pm_breadcrumb_atomic(0xE6);	/* last SW before SYSTEM_SUSPEND SMC */
 	err = invoke_psci_fn(PSCI_FN_NATIVE(1_0, SYSTEM_SUSPEND),
 			      pa_cpu_resume, 0, 0);
 	return psci_to_linux_errno(err);
@@ -539,9 +541,13 @@
 
 static int psci_system_suspend_enter(suspend_state_t state)
 {
+	int ret;
+
 	pm_set_resume_via_firmware();
 
-	return cpu_suspend(0, psci_system_suspend);
+	ret = cpu_suspend(0, psci_system_suspend);
+	thor_pm_breadcrumb_atomic(0xE7);	/* SMC returned: kernel resume began */
+	return ret;
 }
 
 static const struct platform_suspend_ops psci_suspend_ops = {
