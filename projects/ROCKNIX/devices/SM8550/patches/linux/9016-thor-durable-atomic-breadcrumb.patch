From: Luke Johnson <jaewun@me.com>
Subject: [PATCH] thor: make atomic breadcrumb durable (SPMI readback + dsb) before SMC

The atomic breadcrumb may be the last SW before a SoC collapse. Read the byte back
over SPMI and dsb(sy) so a missing mark means a real pre-SMC death, not a lost write.
---
--- a/kernel/power/thor_pm_breadcrumb.c
+++ b/kernel/power/thor_pm_breadcrumb.c
@@ -13,6 +13,7 @@
 #include <linux/of.h>
 #include <linux/printk.h>
 #include <linux/spmi.h>
+#include <asm/barrier.h>
 #include <linux/string.h>
 #include <linux/suspend.h>
 #include <linux/thor_pm_breadcrumb.h>
@@ -561,9 +562,20 @@
 void thor_pm_breadcrumb_atomic(u8 phase)
 {
 	u8 b = phase;
+	u8 rb = 0;
 
-	if (thor_pm_bc_sdev)
+	if (thor_pm_bc_sdev) {
 		spmi_ext_register_writel(thor_pm_bc_sdev, 0x7100 + 0x70, &b, 1);
+		/*
+		 * AYN Thor: this may be the last SW before a SoC power collapse.
+		 * Read the byte back over SPMI (the pmic-arb read also busy-waits
+		 * for DONE, proving it reached the PMIC SDAM), then a full system
+		 * barrier so the breadcrumb is durably committed before any SMC.
+		 */
+		spmi_ext_register_readl(thor_pm_bc_sdev, 0x7100 + 0x70, &rb, 1);
+		(void)rb;
+		dsb(sy);
+	}
 }
 EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_atomic);
 
