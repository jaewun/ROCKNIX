From: Luke Johnson <jaewun@me.com>
Subject: [PATCH] thor: instrument rpmh_flush (TCS contents + trigger + SDAM markers)

Diagnostic: log every flushed sleep/wake cmd (dmesg, capped at runtime, always
during suspend) and latch suspend-time flush markers to SDAM 0x7c-0x7f:
0x7c=0xE8 flush ran, 0x7d=count, 0x7e=cmds written, 0x7f=trigger (C1 cpu_pm/C2 genpd).
---
--- a/kernel/power/thor_pm_breadcrumb.c
+++ b/kernel/power/thor_pm_breadcrumb.c
@@ -579,6 +579,20 @@
 }
 EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_atomic);
 
+void thor_pm_breadcrumb_atomic_at(u8 off, u8 phase)
+{
+	u8 b = phase;
+	u8 rb = 0;
+
+	if (thor_pm_bc_sdev && off >= 0x50 && off <= 0x7f) {
+		spmi_ext_register_writel(thor_pm_bc_sdev, 0x7100 + off, &b, 1);
+		spmi_ext_register_readl(thor_pm_bc_sdev, 0x7100 + off, &rb, 1);
+		(void)rb;
+		dsb(sy);
+	}
+}
+EXPORT_SYMBOL_GPL(thor_pm_breadcrumb_atomic_at);
+
 static int __init thor_pm_breadcrumb_init(void)
 {
 	if (!thor_pm_breadcrumb_machine_enabled())
--- a/include/linux/thor_pm_breadcrumb.h
+++ b/include/linux/thor_pm_breadcrumb.h
@@ -92,6 +92,7 @@
 #ifdef CONFIG_THOR_PM_BREADCRUMB
 void thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data);
 void thor_pm_breadcrumb_atomic(u8 phase);
+void thor_pm_breadcrumb_atomic_at(u8 off, u8 phase);
 void thor_pm_breadcrumb_mark_error(u8 phase, u8 arg, int error);
 void thor_pm_breadcrumb_latch_wake_irq(unsigned int irq);
 void thor_pm_breadcrumb_latch_device(u8 phase, u32 hash);
@@ -103,6 +104,7 @@
 #else
 static inline void thor_pm_breadcrumb_mark(u8 phase, u8 arg, u32 data) {}
 static inline void thor_pm_breadcrumb_atomic(u8 phase) {}
+static inline void thor_pm_breadcrumb_atomic_at(u8 off, u8 phase) {}
 static inline void thor_pm_breadcrumb_mark_error(u8 phase, u8 arg, int error) {}
 static inline void thor_pm_breadcrumb_latch_wake_irq(unsigned int irq) {}
 static inline void thor_pm_breadcrumb_latch_device(u8 phase, u32 hash) {}
--- a/drivers/soc/qcom/rpmh.c
+++ b/drivers/soc/qcom/rpmh.c
@@ -19,6 +19,8 @@
 #include <linux/wait.h>
 
 #include <soc/qcom/rpmh.h>
+#include <linux/suspend.h>
+#include <linux/thor_pm_breadcrumb.h>
 
 #include "rpmh-internal.h"
 
@@ -428,7 +430,10 @@
  */
 int rpmh_flush(struct rpmh_ctrlr *ctrlr)
 {
+	static unsigned int thor_flush_cnt;
 	struct cache_req *p;
+	unsigned int thor_ncmds = 0;
+	bool thor_log, thor_susp;
 	int ret = 0;
 
 	lockdep_assert_irqs_disabled();
@@ -441,6 +446,17 @@
 	if (!spin_trylock(&ctrlr->cache_lock))
 		return -EBUSY;
 
+	thor_flush_cnt++;
+	thor_susp = pm_suspend_target_state != PM_SUSPEND_ON;
+	thor_log = thor_susp || thor_flush_cnt <= 25 || !(thor_flush_cnt % 500);
+	if (thor_susp) {
+		thor_pm_breadcrumb_atomic_at(0x7c, 0xE8);
+		thor_pm_breadcrumb_atomic_at(0x7d, (u8)thor_flush_cnt);
+	}
+	if (thor_log)
+		pr_info("thor rpmh_flush #%u: dirty=%d in_suspend=%d\n",
+			thor_flush_cnt, ctrlr->dirty, thor_susp);
+
 	if (!ctrlr->dirty) {
 		pr_debug("Skipping flush, TCS has latest data.\n");
 		goto write_next_wakeup;
@@ -456,10 +472,15 @@
 
 	list_for_each_entry(p, &ctrlr->cache, list) {
 		if (!is_req_valid(p)) {
-			pr_debug("%s: skipping RPMH req: a:%#x s:%#x w:%#x",
-				 __func__, p->addr, p->sleep_val, p->wake_val);
+			if (thor_log)
+				pr_info("thor rpmh_flush: SKIP  a:%#x s:%#x w:%#x\n",
+					p->addr, p->sleep_val, p->wake_val);
 			continue;
 		}
+		thor_ncmds++;
+		if (thor_log)
+			pr_info("thor rpmh_flush: WRITE a:%#x s:%#x w:%#x\n",
+				p->addr, p->sleep_val, p->wake_val);
 		ret = send_single(ctrlr, RPMH_SLEEP_STATE, p->addr,
 				  p->sleep_val);
 		if (ret)
@@ -471,6 +492,8 @@
 	}
 
 	ctrlr->dirty = false;
+	if (thor_susp)
+		thor_pm_breadcrumb_atomic_at(0x7e, (u8)thor_ncmds);
 
 write_next_wakeup:
 	rpmh_rsc_write_next_wakeup(ctrlr_to_drv(ctrlr));
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -8,6 +8,8 @@
 
 #include <linux/atomic.h>
 #include <linux/cpu_pm.h>
+#include <linux/suspend.h>
+#include <linux/thor_pm_breadcrumb.h>
 #include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -893,6 +895,8 @@
 	 * CPU.
 	 */
 	if (spin_trylock(&drv->lock)) {
+		if (pm_suspend_target_state != PM_SUSPEND_ON)
+			thor_pm_breadcrumb_atomic_at(0x7f, 0xC1);
 		if (rpmh_rsc_ctrlr_is_busy(drv) || rpmh_flush(&drv->client))
 			ret = NOTIFY_BAD;
 		spin_unlock(&drv->lock);
@@ -937,6 +941,9 @@
 	struct rsc_drv *drv = container_of(nfb, struct rsc_drv, genpd_nb);
 
 	/* We don't need to lock as genpd on/off are serialized */
+	if (action == GENPD_NOTIFY_PRE_OFF &&
+	    pm_suspend_target_state != PM_SUSPEND_ON)
+		thor_pm_breadcrumb_atomic_at(0x7f, 0xC2);
 	if ((action == GENPD_NOTIFY_PRE_OFF) &&
 	    (rpmh_rsc_ctrlr_is_busy(drv) || rpmh_flush(&drv->client)))
 		return NOTIFY_BAD;
