# Restore UFS clock policy saved by pre/003-ufs.

. /etc/profile

OLD_UFS_CLKSCALE=$(get_setting "sleep.ufs.clkscale")
if [ ! -n "${OLD_UFS_CLKSCALE}" ]; then
  OLD_UFS_CLKSCALE=1
fi

OLD_UFS_CLKGATE=$(get_setting "sleep.ufs.clkgate")
if [ ! -n "${OLD_UFS_CLKGATE}" ]; then
  OLD_UFS_CLKGATE=1
fi

OLD_UFS_GOVERNOR=$(get_setting "sleep.ufs.governor")

for ufs in /sys/devices/platform/soc@0/*.ufshc; do
  [ -e "${ufs}/clkscale_enable" ] || continue
  echo "${OLD_UFS_CLKSCALE}" > "${ufs}/clkscale_enable" 2>/dev/null
  echo "${OLD_UFS_CLKGATE}"  > "${ufs}/clkgate_enable"  2>/dev/null
done

if [ -n "${OLD_UFS_GOVERNOR}" ]; then
  for gov in /sys/class/devfreq/*ufshc*/governor; do
    [ -e "${gov}" ] || continue
    grep -qw "${OLD_UFS_GOVERNOR}" "${gov%/governor}/available_governors" 2>/dev/null || continue
    echo "${OLD_UFS_GOVERNOR}" > "${gov}" 2>/dev/null
  done
fi
