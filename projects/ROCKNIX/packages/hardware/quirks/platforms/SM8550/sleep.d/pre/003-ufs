# Save UFS clock policy, park it for suspend, and restore it in post/003-ufs.

. /etc/profile

for ufs in /sys/devices/platform/soc@0/*.ufshc; do
  [ -e "${ufs}/clkscale_enable" ] || continue
  set_setting sleep.ufs.clkscale "$(cat ${ufs}/clkscale_enable 2>/dev/null)"
  set_setting sleep.ufs.clkgate  "$(cat ${ufs}/clkgate_enable  2>/dev/null)"
done

for gov in /sys/class/devfreq/*ufshc*/governor; do
  [ -e "${gov}" ] || continue
  set_setting sleep.ufs.governor "$(cat "${gov}" 2>/dev/null)"
  grep -qw powersave "${gov%/governor}/available_governors" 2>/dev/null || continue
  echo powersave > "${gov}" 2>/dev/null
done

for ufs in /sys/devices/platform/soc@0/*.ufshc; do
  [ -e "${ufs}/clkscale_enable" ] || continue
  echo 0 > "${ufs}/clkscale_enable" 2>/dev/null
  echo 0 > "${ufs}/clkgate_enable"  2>/dev/null
done
